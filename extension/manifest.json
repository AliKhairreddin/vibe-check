{
  "manifest_version": 3,
  "name": "AdChecked Live Scanner",
  "version": "0.2.0",
  "description": "Automatically submits live Meta Ads Manager creatives and primary text to AdChecked.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://*.cdninstagram.com/*",
    "https://admin.adchecked.com/*",
    "https://vibe-check.thatcanadian.dev/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://adsmanager.facebook.com/*",
        "https://business.facebook.com/adsmanager/*",
        "https://www.facebook.com/adsmanager/*"
      ],
      "js": [
        "page-observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://adsmanager.facebook.com/*",
        "https://business.facebook.com/adsmanager/*",
        "https://www.facebook.com/adsmanager/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AdChecked Live Scanner"
  },
  "options_page": "options.html"
}
