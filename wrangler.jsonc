{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vibe-check",
  "main": "worker/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "containers": [
    {
      "class_name": "ReviewBackend",
      "image": "./Dockerfile",
      "instance_type": "standard-3",
      "max_instances": 50,
      "rollout_active_grace_period": 300
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "31001",
      "simple": {
        "limit": 15,
        "period": 60
      }
    },
    {
      "name": "ADMIN_AUTH_RATE_LIMITER",
      "namespace_id": "31002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ReviewBackend",
        "name": "REVIEW_BACKEND"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["ReviewBackend"],
      "tag": "v1"
    }
  ],
  "routes": [
    {
      "pattern": "vibe-check.thatcanadian.dev",
      "custom_domain": true
    },
    {
      "pattern": "adchecked.com",
      "custom_domain": true
    },
    {
      "pattern": "www.adchecked.com",
      "custom_domain": true
    },
    {
      "pattern": "app.adchecked.com",
      "custom_domain": true
    },
    {
      "pattern": "admin.adchecked.com",
      "custom_domain": true
    },
    {
      "pattern": "api.adchecked.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "secrets": {
    "required": [
      "ACP_CLIENT_PASSWORD",
      "ADMIN_PASSWORD",
      "CLIENT_ADMIN_PASSWORD",
      "EMPLOYEE_ADMIN_PASSWORD",
      "CONVEX_HTTP_SECRET",
      "GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON",
      "KISSTERRA_CLIENT_PASSWORD",
      "LEAD_ECONOMY_CLIENT_PASSWORD",
      "OPENROUTER_API_KEY",
      "SESSION_SECRET",
      "SMART_FINANCIAL_CLIENT_PASSWORD",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_CHAT_ID"
    ]
  },
  "vars": {
    "API_PUBLIC_URL": "https://api.adchecked.com",
    "APP_ADMIN_HOSTS": "admin.adchecked.com",
    "APP_ALLOWED_HOSTS": "adchecked.com,www.adchecked.com,app.adchecked.com,admin.adchecked.com,api.adchecked.com,vibe-check.thatcanadian.dev,vibe-check.ali-kheireddin1.workers.dev,localhost,127.0.0.1",
    "APP_LEGACY_HOSTS": "vibe-check.thatcanadian.dev",
    "APP_PUBLIC_URL": "https://admin.adchecked.com",
    "BACKEND_SLOT": "primary-v25",
    "CONVEX_URL": "https://energetic-partridge-813.convex.cloud",
    "CORS_ALLOWED_ORIGINS": "https://admin.adchecked.com,https://app.adchecked.com",
    "EMPLOYEE_ADMIN_USERNAME": "employee",
    "GOOGLE_AD_COPY_SHEET_URL": "https://docs.google.com/spreadsheets/d/1p3z7ubxNH8yOh_58CD12XOH6XEN80toI7fvkEgnA29o/edit?usp=drive_link",
    "GOOGLE_DRIVE_ADDITIONAL_FOLDERS_JSON": "{\"kissterra\":{\"name\":\"Kissterra\",\"folder_id\":\"1F3rYM_tVmbNXuYkn00HoaopB0UsUVcn5\"}}",
    "GOOGLE_DRIVE_FOLDER_ID": "16zD3i1-QnFcrfxXECtjf7T0zbUfzcCAd",
    "JOB_DATA_DIR": "/tmp/vibe-check/jobs",
    "JOB_MAX_ATTEMPTS": "2",
    "JOB_PROCESSING_TIMEOUT_SECONDS": "1800",
    "JOB_WORKER_CONCURRENCY": "5",
    "MAX_UPLOAD_MB": "400",
    "OPENROUTER_MODEL": "deepseek/deepseek-v4-flash",
    "OPENROUTER_MAX_ATTEMPTS": "3",
    "OPENROUTER_RETRY_BASE_SECONDS": "1",
    "OPENROUTER_REQUEST_TIMEOUT_SECONDS": "180",
    "OPENROUTER_PROVIDER_SORT": "throughput",
    "OPENROUTER_ZDR": "true",
    "OPENROUTER_DATA_COLLECTION": "deny",
    "OPENROUTER_VISION_ENABLED": "true",
    "OPENROUTER_VISION_MODEL": "minimax/minimax-m3",
    "OPENROUTER_VISION_MAX_ATTEMPTS": "2",
    "OPENROUTER_VISION_MAX_FRAMES": "12",
    "OPENROUTER_VISION_MAX_IMAGE_EDGE": "1024",
    "OPENROUTER_VISION_JPEG_QUALITY": "75",
    "OPENROUTER_STT_MODEL": "openai/whisper-large-v3",
    "OPENROUTER_STT_LANGUAGE": "",
    "OPENROUTER_STT_CHUNK_SECONDS": "10",
    "OPENROUTER_STT_CHUNK_CONCURRENCY": "3",
    "OPENROUTER_STT_MAX_CHUNKS": "30",
    "OPENROUTER_STT_WHOLE_AUDIO_MAX_SECONDS": "90",
    "REVIEW_BACKEND_SHARDS": "10",
    "SESSION_TTL_SECONDS": "43200"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
